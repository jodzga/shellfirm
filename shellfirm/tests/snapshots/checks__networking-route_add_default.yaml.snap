        check_detection_ids: [
            "networking:route_add_default",
        ],
        test_description: "match route add default with sudo",
    },
    TestSensitivePatternsResult {
        file_path: "networking-route_add_default.yaml",
        test: "route delete default gw 10.0.0.1",
