---
source: shellfirm/tests/checks.rs
expression: test_file_results
---
[
    TestSensitivePatternsResult {
        file_path: "package_management-snap.yaml",
        test: "snap install microk8s --classic",
        check_detection_ids: [
            "package_management:snap_operations",
        ],
        test_description: "match snap install command",
    },
    TestSensitivePatternsResult {
        file_path: "package_management-snap.yaml",
        test: "sudo snap remove microk8s",
        check_detection_ids: [
            "package_management:snap_operations",
        ],
        test_description: "match snap remove with sudo",
    },
    TestSensitivePatternsResult {
        file_path: "package_management-snap.yaml",
        test: "snap refresh microk8s",
        check_detection_ids: [
            "package_management:snap_operations",
        ],
        test_description: "match snap refresh",
    },
    TestSensitivePatternsResult {
        file_path: "package_management-snap.yaml",
        test: "snap refresh microk8s --beta",
        check_detection_ids: [
            "package_management:snap_operations",
        ],
        test_description: "match snap refresh from beta channel",
    },
    TestSensitivePatternsResult {
        file_path: "package_management-snap.yaml",
        test: "snap list",
        check_detection_ids: [],
        test_description: "should not match list command",
    },
]
